generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ✅ 1. User Model
model User {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  email          String? @unique
  hashedPassword String
  name           String?
  role           String  @default("user") // "admin" or "user"
  phone          String?
  country        String?
  kycStatus      String  @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED

  // Balance Fields
  portfolioBalance Float @default(0.0)
  availableBalance Float @default(0.0)
  pnl              Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions   Transaction[]
  notifications  Notification[]
  messages       Message[]
  kycSubmissions KycSubmission[]
  supportTickets SupportTicket[]
}

// ✅ 2. Message Model
model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ✅ 3. Notification Model
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ✅ 4. Updated Transaction Model (Supports Deposits, Withdrawals, & Advanced Trading)
model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  
  // Core Fields
  type      String   // "deposit", "withdrawal", "buy", "sell"
  amount    Float    // For trades, this is the Margin (Collateral)
  asset     String   // "USD", "BTC", "ETH", "AAPL", "TSLA", etc.
  status    String   // "Pending", "Completed", "Failed"
  
  // Wallet/Transfer specific
  network   String? 
  address   String? 

  // Trading specific (New for Leverage & Stocks)
  leverage    Int?     @default(1)
  entryPrice  Float?   
  exposure    Float?   // margin * leverage (total position size)
  marginType  String?  @default("ISOLATED") // "ISOLATED" or "CROSS"
  marketType  String?  @default("CRYPTO")   // "CRYPTO" or "STOCKS"
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([asset])
  @@index([marketType])
}

// ✅ 5. Settings Model
model Settings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  btcAddress  String?
  ethAddress  String?
  usdtAddress String?
  updatedAt   DateTime @updatedAt
}

// ✅ 6. KYC Submission Model
model KycSubmission {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  status   String  @default("PENDING") // PENDING | APPROVED | REJECTED
  docType  String?
  fileUrl  String
  fileId   String?
  fileMime String
  fileName String
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ✅ 7. Support Ticket Model
model SupportTicket {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  subject   String
  status    String           @default("OPEN") // OPEN | CLOSED
  priority  String?          // Optional (e.g. LOW | NORMAL | HIGH)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId])
  @@index([status])
}

// ✅ 8. Support Message Model
model SupportMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String        @db.ObjectId
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  sender    String        // USER | ADMIN
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
 
