generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ✅ 1. User Model
model User {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  email            String   @unique
  hashedPassword   String
  name             String?
  role             String   @default("user") // "admin" or "user"
  phone            String?
  country          String?
  
  // Balance Fields
  portfolioBalance Float    @default(0.0)
  availableBalance Float    @default(0.0)
  pnl              Float    @default(0.0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  transactions     Transaction[]
  notifications    Notification[] 
  messages         Message[]
}

// ✅ 2. Message Model (Only one definition now)
model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ✅ 3. Notification Model
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ✅ 4. Transaction Model
model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String   // "deposit" or "withdrawal"
  amount    Float
  status    String   // "Pending", "Completed", "Failed"
  asset     String   // "USD", "BTC", "ETH"
  network   String?  // New field for "BTC", "ERC20", etc.
  address   String?  // New field for the wallet address
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ✅ 5. Settings Model
model Settings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  btcAddress  String?
  ethAddress  String?
  usdtAddress String?
  updatedAt   DateTime @updatedAt
}